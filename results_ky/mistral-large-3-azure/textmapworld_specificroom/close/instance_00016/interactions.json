    [
      {
        "from": "GM",
        "to": "Player 1",
        "timestamp": "2026-07-13T09:56:56.410359",
        "action": {
          "type": "send message",
          "content": "Сураныч, мага төмөнкү тапшырманы аткарууга жардам бериңиз. Максат — бөлмөлөрдү изилдеп, максаттуу бөлмөнү табуу. Ар бир бөлмөдө кайсы багытка барууну чечишиңиз керек. Жоопту төмөнкү форматта бериңиз: Коңшу бөлмөгө өтүү үчүн \"БАР: БАГЫТ\" колдонуңуз жана БАГЫТ ордуна [түндүк, чыгыш, батыш, түштүк] ичинен бирин жазыңыз. Эң маанилүүсү, максаттуу бөлмөнү тапкандан кийин анын ордуна \"БҮТТҮ\" деп жооп бериңиз. Башка эч кандай текстти кошпоңуз.\nМына мисал:\nМаксаттуу бөлмө — Уктоочу бөлмө. Сиз Ашканадасыз. Учурда жеткиликтүү багыттар: түштүк, батыш. Кийинки көрсөтмөңүз кандай?\nБАР: батыш\nСиз бир кадам жасап, Холлго кирдиңиз. Учурда жеткиликтүү багыттар: чыгыш, түндүк. Кийинки көрсөтмөңүз кандай?\nБАР: түндүк\n...\nСиз бир кадам жасап, Уктоочу бөлмөгө кирдиңиз. Учурда жеткиликтүү багыттар: түштүк. Кийинки көрсөтмөңүз кандай?\nБҮТТҮ\nЭми баштайлы. Максаттуу бөлмө — Кол өнөрчүлүк бөлмөсү. Сиз Шкаф бөлмөсүндөсүз. Учурда жеткиликтүү багыттар: батыш, чыгыш, түштүк. Кийинки көрсөтмөңүз кандай?\n",
          "label": "context"
        }
      },
